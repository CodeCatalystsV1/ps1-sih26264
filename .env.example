# AICTE ICMS Environment Configuration
PROJECT_NAME="AICTE Integrated Institution Complaint Monitoring and Coordination Platform"
API_V1_STR="/api"
SECRET_KEY="aicte_icms_super_secret_jwt_key_change_in_production_min_32_chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# Default to SQLite for zero-setup out-of-the-box local execution.
# For production PostgreSQL: postgresql+psycopg2://postgres:password@localhost:5432/aicte_icms
DATABASE_URL="sqlite:///./aicte_icms.db"

# Storage Configuration
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=15

# Scheduled Background Tasks
ENABLE_SCHEDULER=true
DEADLINE_CHECK_INTERVAL_MINUTES=15
